generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  MANAGER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(120)
  passwordHash String    @db.VarChar(255)
  role         UserRole  @default(STAFF)
  inquiries    Inquiry[] @relation("InquiryOwner")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Inquiry {
  id             String        @id @default(uuid()) @db.Uuid
  customerName   String        @db.VarChar(120)
  contactInfo    String        @db.VarChar(160)
  subject        String        @db.VarChar(200)
  description    String        @db.Text
  resolutionNote String?       @db.Text
  status         InquiryStatus @default(NEW)
  version        Int           @default(1)
  ownerId        String        @db.Uuid
  owner          User          @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([ownerId, status])
  @@index([status, updatedAt])
  @@index([contactInfo, subject])
  @@map("inquiries")
}

