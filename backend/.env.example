# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coffee_ninja?schema=public"

# Server Configuration
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# JWT Signing Secret (Must be at least 32 characters / 256 bits)
JWT_SECRET="replace-with- at-least-32-byte-random-secret-key-in-local-env"
JWT_EXPIRES_IN="8h"

